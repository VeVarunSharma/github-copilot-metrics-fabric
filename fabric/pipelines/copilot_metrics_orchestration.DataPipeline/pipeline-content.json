              },
              "type": "string"
            },
            "run_mode": {
              "value": {
                "value": "@pipeline().parameters.run_mode",
                "type": "Expression"
              },
              "type": "string"
            },
            "scope_kind": {
              "value": {
                "value": "@pipeline().parameters.scope_kind",
                "type": "Expression"
              },
              "type": "string"
            },
            "scope_slug": {
              "value": {
                "value": "@pipeline().parameters.scope_slug",
                "type": "Expression"
              },
              "type": "string"
            },
            "entity_type": {
              "value": {
                "value": "@pipeline().parameters.entity_type",
                "type": "Expression"
              },
              "type": "string"
            },
            "start_date": {
              "value": {
                "value": "@if(and(not(empty(pipeline().parameters.earliest_date)), greater(pipeline().parameters.earliest_date, if(equals(pipeline().parameters.run_mode, 'backfill'), formatDateTime(addDays(pipeline().parameters.start_date, mul(-1, pipeline().parameters.calculation_lookback_days)), 'yyyy-MM-dd'), formatDateTime(addDays(utcNow(), mul(-1, add(pipeline().parameters.trailing_days, pipeline().parameters.calculation_lookback_days))), 'yyyy-MM-dd')))), pipeline().parameters.earliest_date, if(equals(pipeline().parameters.run_mode, 'backfill'), formatDateTime(addDays(pipeline().parameters.start_date, mul(-1, pipeline().parameters.calculation_lookback_days)), 'yyyy-MM-dd'), formatDateTime(addDays(utcNow(), mul(-1, add(pipeline().parameters.trailing_days, pipeline().parameters.calculation_lookback_days))), 'yyyy-MM-dd')))",
                "type": "Expression"
              },
              "type": "string"
            },
            "end_date": {
              "value": {
                "value": "@if(equals(pipeline().parameters.run_mode, 'backfill'), pipeline().parameters.end_date, formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd'))",
                "type": "Expression"
              },
              "type": "string"
            },
            "lakehouse_files_root": {
              "value": {
                "value": "@pipeline().parameters.lakehouse_files_root",
                "type": "Expression"
              },
              "type": "string"
            },
            "bronze_folder": {
              "value": {
                "value": "@pipeline().parameters.bronze_folder",
                "type": "Expression"
              },
              "type": "string"
            },
            "silver_schema": {
              "value": {
                "value": "@pipeline().parameters.silver_schema",
                "type": "Expression"
              },
              "type": "string"
            },
            "audit_schema": {
              "value": {
                "value": "@pipeline().parameters.audit_schema",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Gold materialization",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Silver normalization",
            "dependencyConditions": [
              "Succeeded"
