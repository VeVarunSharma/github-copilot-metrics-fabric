	measure 'Pull Requests Created' = SUM ( 'Repository Impact Daily'[pull_requests_created] )
		lineageTag: 219dcfcc-ddd0-5919-b90d-66d3cfa34df2
		displayFolder: Measures
		formatString: #,0

	measure 'Copilot Authored Pull Requests' = SUM ( 'Repository Impact Daily'[pull_requests_created_by_copilot] )
		lineageTag: 38d8e751-47a4-5405-bac7-b4cda98996f4
		displayFolder: Measures
		formatString: #,0

	measure 'Copilot Authored PR Rate' = DIVIDE ( [Copilot Authored Pull Requests], [Pull Requests Created] )
		lineageTag: 1601a45f-55e1-5785-b9af-fb0cff2a17b6
		displayFolder: Measures
		formatString: 0.0%

	measure 'Pull Requests Reviewed' = SUM ( 'Repository Impact Daily'[pull_requests_reviewed] )
		lineageTag: 6830bc0e-bcfe-5586-b19f-3f94a990bd53
		displayFolder: Measures
		formatString: #,0

	measure 'Copilot Reviewed Pull Requests' = SUM ( 'Repository Impact Daily'[pull_requests_reviewed_by_copilot] )
		lineageTag: 73b509e6-756d-5cf4-9511-20956c0a9efc
		displayFolder: Measures
		formatString: #,0

	measure 'Copilot Reviewed PR Rate' = DIVIDE ( [Copilot Reviewed Pull Requests], [Pull Requests Reviewed] )
		lineageTag: b8100e2f-7137-547d-91ba-f1edad93d964
		displayFolder: Measures
		formatString: 0.0%

	measure 'Repository Suggestion Apply Rate' = DIVIDE ( SUM ( 'Repository Impact Daily'[applied_suggestions] ), SUM ( 'Repository Impact Daily'[suggestions] ) )
		lineageTag: e8647721-d76a-5f1c-a999-95a5abcd87a1
		displayFolder: Measures
		formatString: 0.0%

	measure 'Median Minutes to Merge' = MEDIAN ( 'Repository Impact Daily'[median_minutes_to_merge] )
		lineageTag: 9fac9607-850d-568c-886d-830a8c21f127
		displayFolder: Measures
		formatString: #,0.0

	partition repository_copilot_impact_daily = entity
		mode: directLake
		source
			entityName: repository_copilot_impact_daily
			schemaName: gold
			expressionSource: DirectLakeConnection
