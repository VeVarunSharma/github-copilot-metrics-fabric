table 'Adoption Rolling Daily'
	lineageTag: 5da82e01-c7fc-5a07-bd04-650c431facd1

	column scope_kind
		dataType: string
		sourceColumn: scope_kind
		displayFolder: Dimensions

	column scope_slug
		dataType: string
		sourceColumn: scope_slug
		displayFolder: Dimensions

	column day
		dataType: dateTime
		sourceColumn: day
		formatString: yyyy-mm-dd
		displayFolder: Metrics

	column day_key
		dataType: int64
		sourceColumn: day_key
		isHidden
		displayFolder: Technical

	column gold_built_at
		dataType: string
		sourceColumn: gold_built_at
		isHidden
		displayFolder: Technical

	column source_correction_count
		dataType: int64
		sourceColumn: source_correction_count
		isHidden
		displayFolder: Technical

	column dimension_type
		dataType: string
		sourceColumn: dimension_type
		displayFolder: Dimensions

	column dimension_id
		dataType: string
		sourceColumn: dimension_id
		displayFolder: Dimensions

	column dimension_name
		dataType: string
		sourceColumn: dimension_name
		displayFolder: Dimensions

	column window_days
		dataType: int64
		sourceColumn: window_days
		displayFolder: Metrics

	column distinct_active_users
		dataType: int64
		sourceColumn: distinct_active_users
		displayFolder: Metrics

	column allocation_method
		dataType: string
		sourceColumn: allocation_method
		displayFolder: Dimensions

	column is_additive
		dataType: boolean
		sourceColumn: is_additive
		displayFolder: Dimensions

	measure 'Weekly Active Users' = CALCULATE ( SUM ( 'Adoption Rolling Daily'[distinct_active_users] ), KEEPFILTERS ( 'Adoption Rolling Daily'[dimension_type] = "entity" ), KEEPFILTERS ( 'Adoption Rolling Daily'[window_days] = 7 ) )
		lineageTag: e4c6c261-9bdb-5cd9-b486-6b3dfbba85e8
		displayFolder: Measures
		formatString: #,0

	measure '28-Day Active Users' = CALCULATE ( SUM ( 'Adoption Rolling Daily'[distinct_active_users] ), KEEPFILTERS ( 'Adoption Rolling Daily'[dimension_type] = "entity" ), KEEPFILTERS ( 'Adoption Rolling Daily'[window_days] = 28 ) )
		lineageTag: 3fe306db-50d7-514b-9f34-0a1406f63e31
		displayFolder: Measures
		formatString: #,0

	partition adoption_rolling_daily = entity
		mode: directLake
		source
			entityName: adoption_rolling_daily
			schemaName: gold
			expressionSource: DirectLakeConnection
