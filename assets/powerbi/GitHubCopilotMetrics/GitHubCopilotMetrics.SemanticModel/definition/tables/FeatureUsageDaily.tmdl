table 'Feature Usage Daily'
	lineageTag: 62d08d27-ec8c-563a-b1ed-abc03b0dbcc1

	column scope_kind
		dataType: string
		sourceColumn: scope_kind
		displayFolder: Dimensions

	column scope_slug
		dataType: string
		sourceColumn: scope_slug
		displayFolder: Dimensions

	column day
		dataType: dateTime
		sourceColumn: day
		formatString: yyyy-mm-dd
		displayFolder: Metrics

	column day_key
		dataType: int64
		sourceColumn: day_key
		isHidden
		displayFolder: Technical

	column gold_built_at
		dataType: string
		sourceColumn: gold_built_at
		isHidden
		displayFolder: Technical

	column source_correction_count
		dataType: int64
		sourceColumn: source_correction_count
		isHidden
		displayFolder: Technical

	column feature
		dataType: string
		sourceColumn: feature
		displayFolder: Dimensions

	column observed_users
		dataType: int64
		sourceColumn: observed_users
		displayFolder: Metrics

	column active_users
		dataType: int64
		sourceColumn: active_users
		displayFolder: Metrics

	column engaged_users
		dataType: int64
		sourceColumn: engaged_users
		displayFolder: Metrics

	column interaction_count
		dataType: int64
		sourceColumn: interaction_count
		displayFolder: Metrics

	column generation_count
		dataType: int64
		sourceColumn: generation_count
		displayFolder: Metrics

	column acceptance_count
		dataType: int64
		sourceColumn: acceptance_count
		displayFolder: Metrics

	column acceptance_rate
		dataType: double
		sourceColumn: acceptance_rate
		isHidden
		displayFolder: Technical

	column loc_suggested
		dataType: int64
		sourceColumn: loc_suggested
		displayFolder: Metrics

	column loc_accepted
		dataType: int64
		sourceColumn: loc_accepted
		displayFolder: Metrics

	column loc_acceptance_rate
		dataType: double
		sourceColumn: loc_acceptance_rate
		isHidden
		displayFolder: Technical

	column ai_credits_used
		dataType: double
		sourceColumn: ai_credits_used
		displayFolder: Metrics

	measure 'Feature Active Users' = SUM ( 'Feature Usage Daily'[active_users] )
		lineageTag: e9cc1ded-c66a-5561-9b8e-0f42529ae4b2
		displayFolder: Measures
		formatString: #,0

	measure 'Feature Observed Users' = SUM ( 'Feature Usage Daily'[observed_users] )
		lineageTag: 4fb4d821-d334-5f45-947f-ab68e301c5fe
		displayFolder: Measures
		formatString: #,0

	measure 'Feature Adoption Rate' = DIVIDE ( [Feature Active Users], [Feature Observed Users] )
		lineageTag: 07a10e9f-157f-5a09-b435-2d1d788c2534
		displayFolder: Measures
		formatString: 0.0%

	measure 'Feature Acceptance Rate' = DIVIDE ( SUM ( 'Feature Usage Daily'[acceptance_count] ), SUM ( 'Feature Usage Daily'[generation_count] ) )
		lineageTag: 9bc19045-7161-5697-9968-fe66ceeccdcd
		displayFolder: Measures
		formatString: 0.0%

	partition feature_usage_daily = entity
		mode: directLake
		source
			entityName: feature_usage_daily
			schemaName: gold
			expressionSource: DirectLakeConnection
